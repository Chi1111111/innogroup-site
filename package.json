{
  "name": "inno-group-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/generate-static-meta.mjs && node scripts/verify-static-meta.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "jpauc:scrape": "node scripts/jpauc-scrape.mjs",
    "jpauc:oneprice:japan:scrape": "node scripts/jpauc-oneprice-japan-scrape.mjs",
    "jpauc:build:paged": "node scripts/build-jpauc-paged-data.mjs",
    "japan-market:build": "node scripts/build-japan-market-data.mjs",
    "japan-market:sync:carapis": "node scripts/run-japan-market-sync.mjs",
    "japan-market:sync:database": "node scripts/sync-japan-market-supabase.mjs",
    "japan-market:update": "npm run japan-market:sync:carapis",
    "japan-market:update:legacy": "npm run japan-market:build && npm run japan-market:sync:database",
    "jpauc:update": "npm run jpauc:scrape && npm run jpauc:oneprice:japan:scrape && npm run jpauc:build:paged && npm run japan-market:update:legacy"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.106.1",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.54.2",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.7"
  }
}
